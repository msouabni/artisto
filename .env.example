# .env.example — modèle de configuration (AUCUN SECRET ICI).
# Copier dans .env (ou .env.local pour les surcharges locales gitignorées) et
# remplir avec les vraies valeurs. .env et .env.local sont gitignorés.

# ── Ollama (génération texte) ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=60

# ── ComfyUI (génération image) ─────────────────────────────────────────────
# COMFY_URL=http://127.0.0.1:8188

# ── PostgreSQL (runtime DB — Postgres uniquement) ──────────────────────────
DATABASE_URL=postgresql+psycopg://artiste:artiste@127.0.0.1:5432/artiste_coloriage

# ── Cockpit · indexation Google Search Console (URL Inspection API) ────────
# Provider réel gated sur ces deux variables (sinon MockIndexProvider, zéro réseau).
# Chemin du JSON de service account (NE JAMAIS committer le JSON ; le placer dans
# secrets/ qui est gitignoré, ou pointer ailleurs hors du repo).
GSC_SERVICE_ACCOUNT_JSON=secrets/gsc.json
# Propriété GSC à inspecter. Propriété DOMAINE recommandée (couvre tous les sous-domaines/locales) :
GSC_PROPERTY=sc-domain:alwanbooks.com
# Plafond d'inspections par run (optionnel ; défaut ~2000 = quota GSC/jour).
# GSC_DAILY_QUOTA=2000

# Base publique du site pour dériver les URLs des work_items (optionnel).
# COCKPIT_SITE_BASE=https://alwanbooks.com

# ── Cockpit · indexation Bing Webmaster (optionnel, gated) ─────────────────
# BING_WEBMASTER_API_KEY=
# BING_SITE_URL=https://alwanbooks.com/
