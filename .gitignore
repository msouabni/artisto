# Fichier WAL temporaire DuckDB (créé pendant les transactions)
data/*.duckdb.wal

# Fichier de staging des suggestions IA (généré localement, non versionné)
data/ai_suggestions.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
*.egg-info/
dist/
build/

# Logs runtime (API + workers)
logs/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Cursor / IDE
.cursor/debug-*.log

# OS
.DS_Store
Thumbs.db

# Backups locaux (ex. générés par scripts/migrate_benchmark_annotations.py)
*.bak

# Configuration locale Claude Code (worktrees, scheduled tasks, settings perso)
.claude/

# Backups DB (dumps SQL/JSON locaux, ex. pré-purge)
backups/

# PNG générés par les POC benchmark (volumineux, ~635 MB sur 1055 fichiers).
# Les rapports .md/.json à côté sont conservés.
docs/reports/**/*.png
