# Fichier WAL temporaire DuckDB (créé pendant les transactions)
data/*.duckdb.wal

# Fichier de staging des suggestions IA (généré localement, non versionné)
data/ai_suggestions.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env
.env.local
*.egg-info/
dist/
build/

# Logs runtime (API + workers)
logs/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# Cursor / IDE
.cursor/debug-*.log

# OS
.DS_Store
Thumbs.db

# Backups locaux (ex. générés par scripts/migrate_benchmark_annotations.py)
*.bak

# Configuration locale Claude Code (worktrees, scheduled tasks, settings perso)
.claude/

# Backups DB (dumps SQL/JSON locaux, ex. pré-purge)
backups/

# Secrets (service accounts GSC, clés API moteurs). JAMAIS commité.
secrets/

# PNG générés par les POC benchmark (volumineux, ~635 MB sur 1055 fichiers).
# Les rapports .md/.json à côté sont conservés.
docs/reports/**/*.png

# PNG masters copiés par scripts/export_mep_v0.py (volumineux, uploadés
# par alwanbooks-pipeline depuis le bucket source).
# Le manifest.json et les Posts JSON sous data/export/posts/ sont conservés.
data/export/images/*.png

# Simulated R2 outputs from scripts/alwanbooks_pipeline.py --mock
# (PNG/WebP/PDF binaires, volumineux, non commit).
data/export/r2_simulated/

# Plaques/artefacts regenerables (mock content, POC). Binaires non commit ;
# evite les orphelins de rename de slug (ex. poisson-simple-0002.* purge 2026-06-22).
data/generated/

# Clones des sites destinataires (Niveau 1 multi-sites)
data/sites/*/

# POC decoloriage : artefacts intermediaires lourds (regenerables via scripts).
# On garde les scripts, corpus.json, stats.json, planches contact, lines/,
# et les livrables G3/G4/G5 (SVG + diff + previews).
poc/decoloriage/g1a_out/
poc/decoloriage/g2_out/adulte/
poc/decoloriage/g2_out/enfant/
poc/decoloriage/g2_out/tout_petit/
