{
  "version": 1,
  "default_active": ["lineart", "pastel_chromakey"],
  "variants": {
    "pastel_chromakey": {
      "prompt_style": "pastel",
      "force_chromakey": true,
      "chromakey_rgb": [0, 177, 64],
      "extract_preset": "floodfill_chromakey_v1",
