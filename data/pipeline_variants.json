      "extract_preset": "floodfill_chromakey_v1",
      "output_kind": "online_coloring",
      "label": "Flat cartoon chromakey (coloriage en ligne vif)"
    },
    "lineart": {
      "prompt_style": "lineart",
      "force_chromakey": false,
      "chromakey_rgb": null,
      "extract_preset": null,
      "output_kind": "print",
      "label": "Lineart (impression/téléchargement)"
